{
  "name": "demystify",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,server -c cyan,green \"npm:dev:web\" \"npm:server:dev\"",
    "dev:web": "vite",
    "server": "YPERSISTENCE=.data/yjs tsx server/index.ts",
    "server:dev": "YPERSISTENCE=.data/yjs tsx watch server/index.ts",
    "build": "tsc -b && tsc -p tsconfig.server.json && vite build && npm run build:server",
    "build:server": "tsc -p tsconfig.server.build.json",
    "lint": "eslint .",
    "preview": "vite preview",
    "start": "NODE_ENV=production node dist-server/server/index.js",
    "test": "vitest run",
    "test:collaboration": "node scripts/test-collaboration.mjs",
    "test:bundle": "node scripts/check-bundle-size.mjs",
    "test:e2e": "playwright test",
    "test:e2e:quick": "playwright test --project=chromium",
    "test:e2e:update": "playwright test --project=chromium --update-snapshots=all",
    "test:e2e:server": "rm -rf .data/e2e-yjs .data/e2e-rooms.json && NODE_ENV=test ENABLE_TEST_AUTH=1 HOST=127.0.0.1 PORT=8791 APP_URL=http://127.0.0.1:4173 SESSION_SECRET=e2e-local-session-secret GITHUB_CLIENT_ID=e2e-client GITHUB_CLIENT_SECRET=e2e-secret GITHUB_APP_SLUG=e2e-app YPERSISTENCE=.data/e2e-yjs ROOMS_PATH=.data/e2e-rooms.json tsx server/index.ts",
    "test:e2e:web": "DEMYSTIFY_API_TARGET=http://127.0.0.1:8791 vite --host 127.0.0.1 --port 4173"
  },
  "dependencies": {
    "@citation-js/core": "^0.8.2",
    "@citation-js/plugin-bibtex": "^0.8.2",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.8",
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "codemirror": "^6.0.2",
    "connect-pg-simple": "^10.0.0",
    "dompurify": "^3.4.13",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "katex": "^0.18.1",
    "lucide-react": "^1.28.0",
    "morphdom": "^2.7.8",
    "myst-common": "^1.10.0",
    "myst-parser": "^1.7.3",
    "myst-to-html": "^1.7.3",
    "pg": "^8.22.0",
    "prosemirror-commands": "^1.7.2",
    "prosemirror-history": "^1.5.0",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-model": "^1.25.11",
    "prosemirror-state": "^1.4.4",
    "prosemirror-view": "^1.42.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rehype-stringify": "^9.0.4",
    "unified": "^10.1.2",
    "ws": "^8.21.2",
    "y-codemirror.next": "^0.3.5",
    "y-leveldb": "^0.2.0",
    "y-websocket": "^2.1.0",
    "yaml": "^2.9.0",
    "yjs": "^13.6.32"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^9.39.2",
    "@playwright/test": "^1.62.1",
    "@types/connect-pg-simple": "^7.0.3",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/katex": "^0.16.8",
    "@types/node": "^22.19.11",
    "@types/pg": "^8.20.4",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.4",
    "eslint": "^9.39.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^16.5.0",
    "jsdom": "^29.1.1",
    "myst-directives": "^1.7.3",
    "myst-roles": "^1.7.3",
    "tsx": "^4.23.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.53.0",
    "vite": "^6.4.1",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "linkify-it": "6.1.0",
    "markdown-it": "15.0.0"
  }
}
